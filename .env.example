# Copy to .env.local and replace every placeholder with your own value.
# Never commit a real key, token, or private key.

# ── Browser-exposed configuration ──────────────────────────────────────────
# Arbitrum Sepolia RPC endpoint (chain ID 421614).
NEXT_PUBLIC_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Reown / WalletConnect project ID.
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id

# Set to true to show testnet-only UI (faucet, marquee).
NEXT_PUBLIC_TESTNET=true

# Test USDC and Instant Execution channel factory addresses.
NEXT_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CHANNEL_FACTORY=0x0000000000000000000000000000000000000000

# Off-chain relayer endpoints.
NEXT_PUBLIC_RELAYER_URL=http://localhost:4001
NEXT_PUBLIC_RELAYER_WS_URL=ws://localhost:4001/ws

# Grok agent WebSocket endpoint.
NEXT_PUBLIC_GROK_WS_URL=ws://localhost:4001/grok

# Goldsky subgraph GraphQL endpoint.
NEXT_PUBLIC_GOLDSKY_URL=https://api.goldsky.com/api/public/YOUR_PROJECT/subgraphs/YOUR_SUBGRAPH/v1.0.0/gn

# Cloudflare Turnstile site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# ── Server-only configuration ──────────────────────────────────────────────
# Used by /api/limit-orders and /api/usdc-balance.
ALCHEMY_KEY=your_alchemy_key

# USDC address used by /api/usdc-balance.
USDC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ── Scripts only ───────────────────────────────────────────────────────────
# Required by scripts/download_icons.py; not used by the Next.js app.
LOGOKIT_TOKEN=your_logokit_token
